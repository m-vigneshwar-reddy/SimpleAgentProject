# ─────────────────────────────────────────────────────────────────
#  ScamShield AI — Email Credentials
#  Fill in YOUR email details below, then save this file.
#  This file is never shared or uploaded anywhere.
# ─────────────────────────────────────────────────────────────────

# ── CHOOSE YOUR EMAIL PROVIDER ────────────────────────────────────
# Options: gmail   outlook   yahoo   zoho   custom
EMAIL_PROVIDER=gmail

# ── YOUR EMAIL ADDRESS ────────────────────────────────────────────
#EMAIL_ADDRESS=vigneshwarreddy7780@gmail.com
EMAIL_ADDRESS=m.vigneshwer7780@gmail.com
# ── APP PASSWORD (NOT your normal login password) ─────────────────
#
#  For GMAIL:
#    1. Go to https://myaccount.google.com/security
#    2. Enable 2-Step Verification (if not already on)
#    3. Go to https://myaccount.google.com/apppasswords
#    4. Select app: Mail  |  Select device: Windows Computer
#    5. Click Generate — copy the 16-character password here
#
#  For OUTLOOK / HOTMAIL:
#    1. Go to https://account.microsoft.com/security
#    2. Click "Advanced security options"
#    3. Under "App passwords" click Create
#    4. Copy the generated password here
#
#  For YAHOO:
#    1. Go to https://login.yahoo.com/account/security
#    2. Click "Generate app password"
#    3. Copy the password here
#
#EMAIL_APP_PASSWORD=wlqg jcgj byhx nuvz
EMAIL_APP_PASSWORD=lsqv pvxa xerm wksv

# ── WHICH FOLDER TO MONITOR ───────────────────────────────────────
# Gmail: INBOX
# Outlook: Inbox
# Leave as INBOX unless you know what to change
EMAIL_FOLDER=INBOX

# ── HOW OFTEN TO CHECK FOR NEW EMAILS (in seconds) ────────────────
# 30 = check every 30 seconds  |  60 = every minute
POLL_INTERVAL=30

# ── RISK THRESHOLD ────────────────────────────────────────────────
# Emails with risk score ABOVE this are flagged as scam (0-100)
SCAM_THRESHOLD=55
SUSPICIOUS_THRESHOLD=25
